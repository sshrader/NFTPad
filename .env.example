# Postgres (Railway: add the Postgres plugin; DATABASE_URL is injected automatically)
DATABASE_URL=postgres://user:pass@localhost:5432/nftpad

# Solana network: devnet while testing, mainnet-beta later
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Server-side RPC (can be the same; use a private RPC such as Helius on mainnet)
RPC_URL=https://api.devnet.solana.com

# Public URL of the deployed app (used in NFT metadata URIs). No trailing slash.
# Railway: https://<your-app>.up.railway.app
PUBLIC_BASE_URL=http://localhost:3000

# Server wallet that mints holder NFTs and pays rent/fees.
# Base58 secret key OR a JSON array like [12,34,...]. KEEP SECRET. Fund it with a little SOL.
MINT_AUTHORITY_SECRET=

# Coin launch mode:
#   attach  = creators supply an existing SPL token mint (good for testing the claim flow)
#   meteora = server builds a Meteora Dynamic Bonding Curve pool-creation transaction
LAUNCH_MODE=attach
# Must match LAUNCH_MODE (it is read by the browser, so it needs the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_LAUNCH_MODE=attach

# Only needed when LAUNCH_MODE=meteora
PARTNER_CONFIG_ADDRESS=

# Limits
MAX_IMAGE_BYTES=2097152
